{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Claims",
  "description": "Schema for merged CLAIM-*.json claim list (array of claim objects).",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["claim_id", "related_task"],
    "properties": {
      "claim_id": { "type": "string", "pattern": "^CLAIM-[A-Za-z0-9_]+-\\d{3,4}$" },
      "related_task": { "type": "string", "pattern": "^TASK-[A-Za-z0-9_]+-\\d{3,4}$" },
      "code_refs": { "type": "array", "items": { "type": "string" } },
      "test_refs": { "type": "array", "items": { "type": "string" } },
      "notes": { "type": "string" },
      "content_hash": { "type": "string" },
      "timestamp": { "type": "string" }
    },
    "additionalProperties": true
  }
}
